{
  "name": "our-pets",
  "version": "0.2.1",
  "description": "Private desktop pet app with built-in characters.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "npm test && electron-builder --dir",
    "build:unpack": "electron-builder --dir",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac zip --publish never",
    "release:version": "npm version patch --no-git-tag-version",
    "test": "node --test"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "our-pets"
  ],
  "author": "Robben-Ge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robben-Ge/desktop-pet.git"
  },
  "bugs": {
    "url": "https://github.com/Robben-Ge/desktop-pet/issues"
  },
  "homepage": "https://github.com/Robben-Ge/desktop-pet#readme",
  "license": "MIT",
  "devDependencies": {
    "electron": "28.2.9",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
